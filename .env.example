# Whisper API Keys (รองรับหลาย Key คั่นด้วยเครื่องหมายจุลภาค ,)
GROQ_API_KEY=gsk_dummykey1234567890abcdef
OPENAI_API_KEY=

# Meta / Muse API Keys
META_API_KEY=
MUSE_API_KEY=

# OpenCode provider ID: zai-coding-plan (subscription) or zai (pay-as-you-go API)
ZAI_OPENCODE_PROVIDER=zai-coding-plan

# Cloudflare Worker Deployment Token
# รับ Token ได้จาก https://dash.cloudflare.com/profile/api-tokens (เลือก Template: Edit Cloudflare Workers)
CLOUDFLARE_API_TOKEN=

# Worker Registry Custom URL (Optional)
REGISTRY_WORKER_URL=https://antigravity-pairing-broker.rangsarn.workers.dev

# Local LLM server (Exo default: http://127.0.0.1:52415/v1, Ollama: http://127.0.0.1:11434/v1)
# KOOKAI_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# Optional API key for local LLM servers that require authentication
# KOOKAI_LOCAL_LLM_API_KEY=
# Local LLM agent harness: qwen (default), dsh (DeepSeek Harness), claude (Claude Code), or none (direct text chat)
# KOOKAI_LOCAL_HARNESS=dsh
