{
  "expo": {
    "name": "Antigravity",
    "slug": "antigravity",
    "scheme": "antigravity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antigravity.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Antigravity to use speech recognition for voice input.",
        "NSMicrophoneUsageDescription": "Allow Antigravity to use the microphone for voice input."
      },
      "appleTeamId": "847T5J9632"
    },
    "android": {
      "package": "com.antigravity.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Antigravity to access your camera for pairing QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Antigravity to select images for chat context."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Antigravity to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Antigravity to use speech recognition for voice input.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ]
  }
}
